{
  "name": "college-erp-system",
  "version": "1.0.0",
  "description": "Next-Generation College ERP System - One Campus. One Platform. Smarter Education.",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server start",
    "client": "npm --prefix client dev",
    "seed": "npm --prefix server run seed",
    "build": "npm --prefix client run build",
    "test": "node server/tests/api.test.js && node server/tests/workflow.test.js"
  },
  "keywords": [
    "college-erp",
    "higher-education",
    "campus-management",
    "naac-nba",
    "ai-campus-copilot"
  ],
  "author": "Antigravity Engineering",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
