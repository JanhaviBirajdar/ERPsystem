{
  "name": "college-erp-system",
  "version": "1.0.0",
  "description": "Next-Generation College ERP System - One Campus. One Platform. Smarter Education.",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm --prefix client run build",
    "postinstall": "npm --prefix client install && npm --prefix server install",
    "install:all": "npm install && npm --prefix client install && npm --prefix server install",
    "start": "node server/index.js",
    "serve": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm --prefix client dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"node server/index.js\" \"npm --prefix client dev\"",
    "start:all": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"node server/index.js\" \"npm --prefix client dev\"",
    "seed": "node server/db/seed.js",
    "test": "node server/tests/run_all.js"
  },
  "keywords": [
    "college-erp",
    "higher-education",
    "campus-management",
    "naac-nba",
    "ai-campus-copilot"
  ],
  "author": "Antigravity Engineering",
  "license": "ISC",
  "dependencies": {
    "concurrently": "^10.0.6"
  }
}
