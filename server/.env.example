# ==============================================================================
# Modern College ERP SaaS - Production Environment Configuration Template
# Copy this file to .env and provide production credentials before deployment.
# ==============================================================================

# Core Application Settings
NODE_ENV=production
PORT=5000
APP_BASE_URL=https://campuserp.io
CORS_ORIGIN=https://campuserp.io,https://*.campuserp.io

# Security & Cryptographic Secrets (Generate using: openssl rand -base64 32)
JWT_SECRET=replace_with_64_character_cryptographically_secure_random_string
BILLING_WEBHOOK_SECRET=replace_with_webhook_signing_secret_from_payment_dashboard
ENCRYPTION_KEY=replace_with_32_character_aes_encryption_key

# Multi-Tenant Document Database (MongoDB Atlas or Replica Set)
# Leave unset or use 'in-memory' for local persisted disk store
MONGODB_URI=mongodb+srv://erp_admin:SECURE_PASSWORD@cluster0.mongodb.net/college_erp_saas?retryWrites=true&w=majority

# Commercial Billing & Payment Gateway Integration (Stripe / Razorpay)
STRIPE_SECRET_KEY=sk_live_replace_with_production_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_webhook_signing_secret
RAZORPAY_KEY_ID=rzp_live_replace_with_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret

# AI Campus Copilot Provider Credentials (Server-side Only)
# Optional: Model provider key (e.g., Gemini or OpenAI). System operates in local grounded mode if omitted.
AI_PROVIDER_KEY=AIzaSy_replace_with_google_ai_or_gemini_api_key
AI_MODEL_ID=gemini-1.5-flash

# Disaster Recovery & Backup Settings
BACKUP_DIR=./backups
BACKUP_SCHEDULE_CRON="0 2 * * *" # Daily at 02:00 UTC
BACKUP_RETENTION_DAYS=30

# Rate Limiting & DoS Protection
RATE_LIMIT_AUTH_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_AI_WINDOW_MS=60000   # 1 minute
RATE_LIMIT_AI_MAX=60

# Telemetry & Structured Logging
LOG_LEVEL=info # 'info' | 'warn' | 'error' | 'debug'
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
